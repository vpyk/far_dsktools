From a8379266e988157eb8dba43a795f3d60fca45175 Mon Sep 17 00:00:00 2001
From: Viktor Pykhonin <pyk@mail.ru>
Date: Wed, 21 Oct 2026 23:09:08 +0300
Subject: [PATCH 2/2] DOS 3.3: mkdir of a DOS 3.3 directory took its name from
 the wrong place

For a DOS 3.3 source mkdir copied the name from the start of the
directory entry in the metadata (&metadata->dir_entry: T/S list track and
sector, file type, then the name) instead of from its name field, so the
new directory got three bytes of garbage in front of a truncated name.

Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/filesystems/fs_dos33.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/filesystems/fs_dos33.cpp b/src/filesystems/fs_dos33.cpp
index dfc49ff..36d6b2c 100644
--- a/src/filesystems/fs_dos33.cpp
+++ b/src/filesystems/fs_dos33.cpp
@@ -395,7 +395,7 @@ namespace dsk_tools {
         if (uf.fs == FS::DOS33) {
             // For native FS we take an original filename
             const auto * metadata = reinterpret_cast<const Apple_DOS_File_Metadata *>(uf.metadata.data());
-            std::memcpy(dir_entry->name, &metadata->dir_entry, sizeof(dir_entry->name));
+            std::memcpy(dir_entry->name, metadata->dir_entry.name, sizeof(dir_entry->name));
         } else {
             // For other cases we convert from universal name
             std::memset(dir_entry->name, 0xA0, sizeof(dir_entry->name));
-- 
