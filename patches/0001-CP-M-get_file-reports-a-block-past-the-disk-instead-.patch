From 84c338a8f9e097a3d4f9b83c8fac74f0cada972b Mon Sep 17 00:00:00 2001
From: Viktor Pykhonin <pyk@mail.ru>
Date: Thu, 12 Nov 2026 23:55:14 +0300
Subject: [PATCH 1/3] CP/M: get_file reports a block past the disk instead of
 crashing

fsCPM::load_file() took every block number of a directory entry as it
was. One past the end of the image made get_sector_data() return
nullptr, and inserting from it crashed. A damaged entry, or a disk read
with the wrong geometry (its directory then holds code or text), has
such numbers.

load_file() now returns a Result: ReadError for a block number above
DSM, which is not on the disk even when it falls inside the image, and
for a sector the image does not hold, as fsDOS33 and fsFAT do. get_file()
passes it on.

Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/filesystems/fs_cpm.cpp | 9 ++++++---
 src/filesystems/fs_cpm.h   | 2 +-
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/filesystems/fs_cpm.cpp b/src/filesystems/fs_cpm.cpp
index 712198c..92dee3b 100644
--- a/src/filesystems/fs_cpm.cpp
+++ b/src/filesystems/fs_cpm.cpp
@@ -361,7 +361,7 @@ fsCPM::fsCPM(diskImage * image, const std::string &filesystem_id, const DiskDefs
         return result;
     }
 
-    void fsCPM::load_file(const BYTES & dir_records, BYTES & out) const
+    Result fsCPM::load_file(const BYTES & dir_records, BYTES & out) const
     {
         out.clear();
         int file_size = 0;
@@ -383,6 +383,8 @@ fsCPM::fsCPM(diskImage * image, const std::string &filesystem_id, const DiskDefs
                 al_ind += DPB.DSM<256 ? 1 : 2;
                 if (AL != 0 && AL != 0xE5 && AL != 0xE5E5)  {
                     // std::cout << AL << std::endl;
+                    // A damaged entry (or a wrong geometry) may point past the disk
+                    if (AL > DPB.DSM) return Result::error(ErrorCode::ReadError);
                     for (int k=0; k<spb; k++) {
                         const int sector_index = AL*spb + k + index_shift;
                         int head, track;
@@ -395,12 +397,14 @@ fsCPM::fsCPM(diskImage * image, const std::string &filesystem_id, const DiskDefs
                         }
                         const int sector = translate_sector(sector_index % sectors);
                         const auto p = image->get_sector_data(head, track, sector);
+                        if (!p) return Result::error(ErrorCode::ReadError);
                         out.insert(out.end(), p, p + sector_size);
                     }
                 }
             }
         }
         out.resize(file_size);
+        return Result::ok();
     }
 
     std::vector<std::string> fsCPM::get_save_file_formats()
@@ -416,8 +420,7 @@ fsCPM::fsCPM(diskImage * image, const std::string &filesystem_id, const DiskDefs
     Result fsCPM::get_file(const UniversalFile & uf, const std::string & format, BYTES & data) const
     {
         data.clear();
-        load_file(uf.metadata, data);
-        return Result::ok();
+        return load_file(uf.metadata, data);
     }
 
     Result fsCPM::dir(std::vector<dsk_tools::UniversalFile> & files, bool show_deleted)
diff --git a/src/filesystems/fs_cpm.h b/src/filesystems/fs_cpm.h
index fdeeb27..59ece7f 100644
--- a/src/filesystems/fs_cpm.h
+++ b/src/filesystems/fs_cpm.h
@@ -51,7 +51,7 @@ namespace dsk_tools {
         DiskDefs m_diskdefs;
         CharmapInfo m_charmap = {};
         std::string make_file_name(CPM_DIR_ENTRY & di) const;
-        void load_file(const BYTES & dir_records, BYTES & out) const;
+        Result load_file(const BYTES & dir_records, BYTES & out) const;
 
     public:
         fsCPM(diskImage * image, const std::string & filesystem_id, const DiskDefs & diskdefs);
