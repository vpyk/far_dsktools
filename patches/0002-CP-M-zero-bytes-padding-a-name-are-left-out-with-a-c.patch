From 6ff63035772ca8dd0cab3f2cc8fa02f92adcd430 Mon Sep 17 00:00:00 2001
From: Viktor Pykhonin <pyk@mail.ru>
Date: Thu, 12 Nov 2026 23:55:50 +0300
Subject: [PATCH 2/3] CP/M: zero bytes padding a name are left out with a
 charmap too

Some programs pad CP/M names with zero bytes instead of spaces
("LINES   HI\0"). make_file_name() skipped them only without a charmap;
with one, a zero went through the charmap, and koi8_m (Vector) shows
control codes as ".", so the name came out as "LINES.HI.".

Both branches now leave out a byte whose low seven bits are zero. That
also covers a zero padding byte of the extension that carries an
attribute bit (0x80): without a charmap it used to put a NUL character
into the name.

Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/filesystems/fs_cpm.cpp | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/filesystems/fs_cpm.cpp b/src/filesystems/fs_cpm.cpp
index 92dee3b..6e8782a 100644
--- a/src/filesystems/fs_cpm.cpp
+++ b/src/filesystems/fs_cpm.cpp
@@ -139,13 +139,15 @@ fsCPM::fsCPM(diskImage * image, const std::string &filesystem_id, const DiskDefs
 
     std::string fsCPM::make_file_name(CPM_DIR_ENTRY & di) const
     {
+        // Some programs pad a name with zero bytes instead of spaces; an attribute bit
+        // (E[0..2]) may be set on such a byte too. They are left out either way.
         std::string name, ext;
         if (m_charmap.charmap) {
-            for (const unsigned char i : di.F) name += (*m_charmap.charmap)[i];
-            for (const unsigned char i : di.E) ext += (*m_charmap.charmap)[i];
+            for (const unsigned char i : di.F) if (i & 0x7F) name += (*m_charmap.charmap)[i];
+            for (const unsigned char i : di.E) if (i & 0x7F) ext += (*m_charmap.charmap)[i];
         } else {
-            for (const unsigned char i : di.F) i ? name += static_cast<char>(i & 0x7F) : "";
-            for (const unsigned char i : di.E) i ? ext += static_cast<char>(i & 0x7F) : "";
+            for (const unsigned char i : di.F) if (i & 0x7F) name += static_cast<char>(i & 0x7F);
+            for (const unsigned char i : di.E) if (i & 0x7F) ext += static_cast<char>(i & 0x7F);
         }
         ext = trim(ext);
         return trim(name) + ((!ext.empty())?("."+ext):"");
