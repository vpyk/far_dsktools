From c5636414433e6f0e3d12e4cb4ca419b1b4f9d370 Mon Sep 17 00:00:00 2001
From: Viktor Pykhonin <pyk@mail.ru>
Date: Fri, 16 Oct 2026 01:20:39 +0300
Subject: [PATCH] DOS 3.3: find_empty_sector searches the whole disk

put_file and mkdir could fail with "Can't allocate a sector" although
free_sectors() reported enough space:

- The search went only up from start_track: "track >= start_track ? +1
  : -1" is +1 after the first step, so tracks below the catalog track
  (0..16 on a 140K disk) were never used.
- It stopped at get_tracks() (80 on an Agat 840K disk), while DOS 3.3
  tracks are logical, 0..159 over both sides, and free_sectors() counts
  get_tracks() * get_heads(). The second half of a 840K disk was never
  used.

Now it searches from start_track to the last logical track, then from
start_track - 1 down to 0, over get_tracks() * get_heads() tracks.

Assisted-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/filesystems/fs_dos33.cpp | 46 +++++++++++++++---------------------
 1 file changed, 19 insertions(+), 27 deletions(-)

diff --git a/src/filesystems/fs_dos33.cpp b/src/filesystems/fs_dos33.cpp
index ee5d670..dfc49ff 100644
--- a/src/filesystems/fs_dos33.cpp
+++ b/src/filesystems/fs_dos33.cpp
@@ -278,34 +278,26 @@ namespace dsk_tools {
     {
         // std::cout << "find_empty_sector: start_track=" << (int)start_track << std::endl;
 
-        int track = start_track;
-        int sector;
-
-        do {
-            int inc;
-            if (go_forward) {
-                sector = 0;
-                inc = 1;
-            } else {
-                sector = image->get_sectors()-1;
-                inc = -1;
-            }
-
-            while (sector>=0 && sector<image->get_sectors() && !sector_is_free(0, track, sector)) sector += inc;
-
-            if (sector >=0 && sector < image->get_sectors()) {
-                ts.track = track;
-                ts.sector = sector;
-
-                // std::cout << "==> found T:S = " << track << ":" << sector << std::endl;
-
-                return true;
-            } else {
-                track += (track >= start_track)?1:-1;
-                if (track < 0 || track >= image->get_tracks())
-                    return false;
+        // Logical tracks, the same range free_sectors() counts: on a two-sided disk
+        // (Agat 840K) they run over both sides
+        const int tracks = image->get_tracks() * image->get_heads();
+        const int sectors = image->get_sectors();
+
+        // From start_track to the end of the disk, then from below start_track down to 0
+        for (int pass = 0; pass < 2; pass++) {
+            const int step = (pass == 0) ? 1 : -1;
+            for (int track = (pass == 0) ? start_track : start_track - 1; track >= 0 && track < tracks; track += step) {
+                for (int i = 0; i < sectors; i++) {
+                    const int sector = go_forward ? i : sectors - 1 - i;
+                    if (sector_is_free(0, track, sector)) {
+                        ts.track = track;
+                        ts.sector = sector;
+                        return true;
+                    }
+                }
             }
-        } while (true);
+        }
+        return false;
     }
 
     bool fsDOS33::find_epmty_dir_entry(Apple_DOS_File *& dir_entry, int & dir_pos, bool just_check, bool &extra_sector)
