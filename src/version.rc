// Part of DskTools, a FAR Manager plugin for disk images of retro computers
// VERSIONINFO of DskTools.dll (file properties in Explorer); the numbers come from version.hpp
#include <winres.h>
#include "version.hpp"

#define DSKTOOLS_STR2(x) #x
#define DSKTOOLS_STR(x)  DSKTOOLS_STR2(x)
#define DSKTOOLS_VERSION_STR \
    DSKTOOLS_STR(PLUGIN_VERSION_MAJOR) "." DSKTOOLS_STR(PLUGIN_VERSION_MINOR) "." DSKTOOLS_STR(PLUGIN_VERSION_BUILD) ".0"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_BUILD, 0
 PRODUCTVERSION PLUGIN_VERSION_MAJOR, PLUGIN_VERSION_MINOR, PLUGIN_VERSION_BUILD, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Viktor Pykhonin"
            VALUE "FileDescription",  "DskTools - FAR Manager plugin for disk images of retro computers"
            VALUE "FileVersion",      DSKTOOLS_VERSION_STR
            VALUE "InternalName",     "DskTools"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Viktor Pykhonin. GPL-3.0-or-later"
            VALUE "OriginalFilename", "DskTools.dll"
            VALUE "ProductName",      "DskTools"
            VALUE "ProductVersion",   DSKTOOLS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
